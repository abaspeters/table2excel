# Copy to .env and fill in. Never commit .env to git.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: shared password for the app. Leave blank for no login.
APP_PASSWORD=

# Optional tuning
EXTRACTION_MODEL=claude-sonnet-5
MAX_PAGES_PER_FILE=40
MAX_PAGES_PER_RUN=120
MAX_FILE_MB=50
MAX_WORKERS=4
